# Environment Configuration
# Copy file ini menjadi .env dan isikan dengan nilai yang sesuai

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce

# Gmail SMTP Configuration
# Gunakan App Password, bukan password Gmail biasa
# Cara membuat App Password: https://support.google.com/accounts/answer/185833
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-16-digit-app-password

# Base URL
BASE_URL=http://localhost/ecommerce
API_URL=http://localhost/ecommerce/api
